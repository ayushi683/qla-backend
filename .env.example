# Copy this file to .env and fill in real values before deploying.
# Never commit the actual .env file.

SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///instance/qla.db

# Given to the Outlook listener service for /api/enquiries/ingest calls.
# Not a user password — this is service-to-service auth, keep it separate
# from SECRET_KEY (which signs user login JWTs).
INGESTION_API_KEY=change-this-to-a-long-random-string-too
VITE_API_BASE=http://localhost:8000